# ============================================================
# 密钥与本机运行状态 —— 绝对不能提交
# ============================================================

# 真实配置（含 AppID / AppSecret）。模板 config.example.json 不受影响。
config.json
config.local.json
*.secret.json

# access_token 缓存
.token_cache.json
.token_cache*.json

# 环境变量文件
.env
.env.*

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# 运行产生的素材（make_assets.py 的输出）
# ============================================================
assets/*.png
assets/*.jpg
assets/*.jpeg
assets/*.gif
!assets/templates/

