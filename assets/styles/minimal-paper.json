  "writing": {
    "tone": "平静、有判断。像写给同行看的长文，允许有观点和取舍，但不咄咄逼人。",
    "opening": "从一个具体场景或一个反常识的观察切入，不解释背景，背景放到第二段。",
    "heading": "只用最轻的小标题，或干脆不设小标题，靠空行与分隔线推进。",
    "paragraph": "段落偏短，2-3 行。允许单句成段做停顿。",
    "emoji": "禁用。",
    "closing": "留一个开放的问题或一个判断，不总结全文。",
    "avoid": ["小标题党", "彩色强调滥用", "每段都加粗重点", "营销式收尾"]
  }
