  "tokens": {
    "primary": "#111111",
    "primary_soft": "#fafafa",
    "text": "#333333",
    "text_strong": "#111111",
    "muted": "#7c7c7c",
    "border": "#e8e8e8",
    "card_bg": "#f6f6f4",
    "code_bg": "#f4f3f0",
    "code_text": "#292929",
    "table_head_bg": "#f3f3f1",
    "table_head_text": "#111111",
    "font_size": "16px",
    "heading_size": "18px",
    "line_height": "1.9",
    "letter_spacing": "0.5px",
    "radius": "3px",
    "para_margin": "20px"
  },
  "code_highlight": {
    "keyword": "#b5382c",
    "string": "#2f5575",
    "comment": "#7a7a74",
